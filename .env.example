# ==============================================================================
# SecureCloud — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE SECURE RANDOM VALUES FOR PRODUCTION
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ==============================================================================

# Database Connection (Async SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./backend/cloudstorage.db

# JWT Cryptographic Signing Key (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Token Expiration (in minutes) — Default: 7 days
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default User Storage Quota (in Bytes) — Default: 15 GB
DEFAULT_STORAGE_QUOTA_BYTES=16106127360

# PBKDF2HMAC Master Key Derivation Salt (Unique per deployment)
MASTER_KEY_SALT=change-this-to-a-unique-random-salt-in-production

# Server Host & Port
HOST=127.0.0.1
PORT=8000
