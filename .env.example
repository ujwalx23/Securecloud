# ==============================================================================
# SecureCloud — Production & Cloud Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE REAL CREDENTIALS
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Local / SQLite (Default):
DATABASE_URL=sqlite+aiosqlite:///./backend/cloudstorage.db

# For Production Managed PostgreSQL (e.g., Supabase, Neon, Render Postgres, AWS RDS):
# DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/securecloud

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC KEYS & SECURITY
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Unique salt for master key derivation
MASTER_KEY_SALT=change-this-to-a-unique-random-salt-in-production
# Default Storage Quota per user (1 GB = 1073741824 bytes -> 10 users = 10 GB Free Tier)
DEFAULT_STORAGE_QUOTA_BYTES=1073741824

# ------------------------------------------------------------------------------
# 3. REAL CLOUD STORAGE ENGINE (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Choose: "r2", "s3", or "local" (default: local)
STORAGE_BACKEND=local

# --- CLOUDFLARE R2 SETUP (RECOMMENDED: 10 GB Free Storage, $0 Egress/Bandwidth Fees) ---
# 1. Log in to dash.cloudflare.com -> R2 Object Storage -> Create Bucket (e.g. "securecloud-vault")
# 2. Click "Manage R2 API Tokens" -> "Create API Token" (Permission: Object Read & Write)
# 3. Paste the Endpoint URL, Access Key ID, and Secret Access Key below:
# STORAGE_BACKEND=r2
# S3_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-r2-access-key-id
# S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# S3_BUCKET_NAME=securecloud-vault
# S3_REGION_NAME=auto

# --- AWS S3 SETUP (Alternative) ---
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=your-aws-access-key-id
# S3_SECRET_ACCESS_KEY=your-aws-secret-access-key
# S3_BUCKET_NAME=your-s3-bucket-name
# S3_REGION_NAME=us-east-1

# ------------------------------------------------------------------------------
# 4. SERVER BINDING
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
